data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=receptor_tmp.maps.xyz filetype=ascii offset=0
coord 2 file=receptor_tmp.maps.xyz filetype=ascii offset=2
coord 3 file=receptor_tmp.maps.xyz filetype=ascii offset=4
